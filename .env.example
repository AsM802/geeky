# Copy this file to .env.local (local development) and fill values before running the app
# MONGODB_URI: MongoDB connection string for local development or Atlas
# Example (Atlas SRV): mongodb+srv://<user>:<password>@cluster0.mongodb.net/geeky?retryWrites=true&w=majority
MONGODB_URI=

# NEXT_PUBLIC_API_URL: (optional) if set, the frontend will call this base URL for API requests
# If left empty, the frontend will use same-origin /api/* routes (recommended for self-contained deploys)
NEXT_PUBLIC_API_URL=

# Optional: Set to 'true' to also seed a demo user when running the seed script
SEED_DEMO_USER=true
